# === REQUIRED ===

# GitHub Personal Access Token (with repo access to bluum-website)
GITHUB_TOKEN=ghp_xxx

# Gemini API Key (for image generation with Nano Banana)
GEMINI_API_KEY=xxx

# === OPTIONAL (only for Web UI / Webhook) ===

# Notion API Key - NOT needed if using MCP server with Claude
# Only required for Web UI and Webhook endpoints
# Get from: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxx

# Webhook Secret (secures the webhook endpoint)
WEBHOOK_SECRET=your-secret-key
